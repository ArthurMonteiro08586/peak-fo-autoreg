# --- paths (optional; default = repo dir) ---
PEAK_HOME=
PEAK_BANK=
PEAK_SIDECAR=

# --- mailbox that receives the confirmation emails (REQUIRED) ---
# catch-all domain forwarding to this IMAP box
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=you@gmail.com
IMAP_PASS=your-app-password

# --- your catch-all alias domain (REQUIRED) ---
# e.g. a domain where *@yourdomain forwards to IMAP_USER
PEAK_ALIAS_DOMAIN=example.com

# --- vision endpoint (OpenAI-compatible /v1/chat/completions) ---
# must serve a vision model; default model id used: qwen3-vl-plus
VISION_BASE=http://127.0.0.1:16432
VISION_KEY=your-e…-key

# --- peak.fo overrides (normally auto-extracted from site JS) ---
PEAK_SITEKEY=
PEAK_SUPA_URL=
PEAK_ANON_KEY=

# --- optional ---
PEAK_PROXY=
PEAK_DASH_PORT=8575
